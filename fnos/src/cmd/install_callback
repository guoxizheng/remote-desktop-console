#!/bin/bash
# 安装完成后：准备数据目录 + 修复二进制执行权限
mkdir -p "${TRIM_PKGVAR}/home" 2>/dev/null
chmod +x "${TRIM_APPDEST}/vendor/rdp/usr/bin/xfreerdp" 2>/dev/null
chmod +x "${TRIM_APPDEST}/vendor/vnc/usr/bin/x11vnc" 2>/dev/null
if [ "$(id -u)" = "0" ] && [ -n "${TRIM_USERNAME}" ]; then
    chown -R "${TRIM_USERNAME}:${TRIM_GROUPNAME}" "${TRIM_PKGVAR}" 2>/dev/null
fi
exit 0
